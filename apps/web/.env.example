# Opcional: Next.js consulta esta URL desde el servidor; nunca usar secretos NEXT_PUBLIC_.
API_BASE_URL=http://127.0.0.1:3001
# Opcional. Es una clave de navegador: restringirla por HTTP referrer y a Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
# DEMO_MAP_ID sirve para desarrollo; usar un Map ID propio en un entorno institucional.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
