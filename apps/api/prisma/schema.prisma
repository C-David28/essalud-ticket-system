// Mapeo del esquema SQL existente. No usar db push ni prisma migrate.
generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
  schemas = ["app", "audit"]
}
model RedAsistencial {
  redAsistencialId String @id @default(dbgenerated("gen_random_uuid()")) @map("red_asistencial_id") @db.Uuid
  codigo String @unique @db.VarChar(30)
  nombre String @db.VarChar(200)
  activo Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  centros CentroAsistencial[]
  roles InstitutionalRole[]
  @@map("redes_asistenciales")
  @@schema("app")
}
model CentroAsistencial {
  redAsistencialId String @map("red_asistencial_id") @db.Uuid
  centroAsistencialId String @default(dbgenerated("gen_random_uuid()")) @map("centro_asistencial_id") @db.Uuid
  codigo String @db.VarChar(30)
  nombre String @db.VarChar(200)
  tipo String @db.VarChar(20)
  activo Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  red RedAsistencial @relation(fields: [redAsistencialId], references: [redAsistencialId], onDelete: Restrict, onUpdate: Restrict)
  areas Area[]
  @@id([redAsistencialId, centroAsistencialId])
  @@unique([redAsistencialId, codigo])
  @@map("centros_asistenciales")
  @@schema("app")
}
model Area {
  tickets Ticket[]
  redAsistencialId String @map("red_asistencial_id") @db.Uuid
  centroAsistencialId String @map("centro_asistencial_id") @db.Uuid
  areaId String @default(dbgenerated("gen_random_uuid()")) @map("area_id") @db.Uuid
  codigo String @db.VarChar(30)
  nombre String @db.VarChar(200)
  activo Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  centro CentroAsistencial @relation(fields: [redAsistencialId, centroAsistencialId], references: [redAsistencialId, centroAsistencialId], onDelete: Restrict, onUpdate: Restrict)
  @@id([redAsistencialId, centroAsistencialId, areaId])
  @@unique([redAsistencialId, centroAsistencialId, codigo])
  @@map("areas")
  @@schema("app")
}
model InstitutionalRole {
  redAsistencialId String @map("red_asistencial_id") @db.Uuid
  roleId String @default(dbgenerated("gen_random_uuid()")) @map("role_id") @db.Uuid
  codigo String @db.VarChar(30)
  nombre String @db.VarChar(120)
  descripcion String @db.VarChar(500)
  alcance String @db.VarChar(12)
  activo Boolean @default(true)
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  red RedAsistencial @relation(fields:[redAsistencialId],references:[redAsistencialId],onDelete:Restrict,onUpdate:Restrict)
  @@id([redAsistencialId,roleId])
  @@unique([redAsistencialId,codigo])
  @@map("roles_institucionales")
  @@schema("app")
}

model InstitutionalUser {
  redAsistencialId String @map("red_asistencial_id") @db.Uuid
  userId String @default(dbgenerated("gen_random_uuid()")) @map("usuario_id") @db.Uuid
  username String @db.VarChar(120)
  displayName String @map("display_name") @db.VarChar(160)
  passwordHash String @map("password_hash") @db.VarChar(200)
  active Boolean @default(true) @map("activo")
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  @@id([redAsistencialId,userId])
  @@unique([redAsistencialId,username])
  @@map("usuarios_institucionales")
  @@schema("app")
}

model UserAccess {
  redAsistencialId String @map("red_asistencial_id") @db.Uuid
  accessId String @default(dbgenerated("gen_random_uuid()")) @map("access_id") @db.Uuid
  userId String @map("usuario_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  centerId String? @map("centro_asistencial_id") @db.Uuid
  active Boolean @default(true) @map("activo")
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  @@id([redAsistencialId,accessId])
  @@index([redAsistencialId,userId,active],map:"usuario_accesos_user_idx")
  @@map("usuario_accesos")
  @@schema("app")
}

model AuditLog {
  auditId String @id @default(dbgenerated("gen_random_uuid()")) @map("audit_id") @db.Uuid
  redAsistencialId String @map("red_asistencial_id") @db.Uuid
  centroAsistencialId String? @map("centro_asistencial_id") @db.Uuid
  areaId String? @map("area_id") @db.Uuid
  userId String? @map("user_id") @db.Uuid
  actorKind String @map("actor_kind") @db.VarChar(8)
  dbSessionUser Unsupported("name") @map("db_session_user")
  dbEffectiveRole Unsupported("name") @map("db_effective_role")
  action String @db.VarChar(6)
  entity String
  entityId Json @map("entity_id")
  oldValues Json? @map("old_values")
  newValues Json? @map("new_values")
  timestamp DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  requestId String? @map("request_id") @db.Uuid
  transactionId BigInt @default(dbgenerated("txid_current()")) @map("transaction_id")
  @@index([redAsistencialId, timestamp(sort: Desc), auditId], map: "audit_logs_tenant_time_idx")
  @@index([redAsistencialId, entity, timestamp(sort: Desc)], map: "audit_logs_tenant_entity_idx")
  // El indice parcial por solicitud, CHECK, RLS y triggers viven en el SQL versionado.
  @@map("audit_logs")
  @@schema("audit")
}

model Ticket {
  redAsistencialId String @map("red_asistencial_id") @db.Uuid
  ticketId String @default(dbgenerated("gen_random_uuid()")) @map("ticket_id") @db.Uuid
  centroAsistencialId String @map("centro_asistencial_id") @db.Uuid
  areaId String @map("area_id") @db.Uuid
  codigo String @unique @default(dbgenerated()) @db.VarChar(40)
  titulo String @db.VarChar(200)
  descripcion String @db.VarChar(5000)
  categoria String @db.VarChar(20)
  prioridad String @db.VarChar(10)
  estado String @default("ABIERTO") @db.VarChar(20)
  solicitanteId String @default(dbgenerated()) @map("solicitante_id") @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt DateTime? @map("closed_at") @db.Timestamptz(6)
  assignedTo String? @map("assigned_to") @db.Uuid
  assignedAt DateTime? @map("assigned_at") @db.Timestamptz(6)
  assignmentMode String? @map("assignment_mode") @db.VarChar(10)
  area Area @relation(fields:[redAsistencialId,centroAsistencialId,areaId], references:[redAsistencialId,centroAsistencialId,areaId],onDelete:Restrict,onUpdate:Restrict)
  assignedTechnician SupportTechnician? @relation(fields:[redAsistencialId,assignedTo],references:[redAsistencialId,technicianId],onDelete:Restrict,onUpdate:Restrict)
  @@id([redAsistencialId,ticketId])
  @@index([redAsistencialId,createdAt(sort: Desc),ticketId(sort: Desc)],map:"tickets_tenant_created_idx")
  @@map("tickets")
  @@schema("app")
}

model SupportTechnician {
  redAsistencialId String @map("red_asistencial_id") @db.Uuid
  technicianId String @default(dbgenerated("gen_random_uuid()")) @map("tecnico_id") @db.Uuid
  name String @map("nombre") @db.VarChar(160)
  level String @map("nivel") @db.VarChar(2)
  maxCapacity Int @default(10) @map("capacidad_maxima") @db.SmallInt
  active Boolean @default(true) @map("activo")
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  tickets Ticket[]
  @@id([redAsistencialId,technicianId])
  @@unique([redAsistencialId,name])
  @@map("tecnicos_soporte")
  @@schema("app")
}

model TicketAssignmentHistory {
  redAsistencialId String @map("red_asistencial_id") @db.Uuid
  assignmentId String @default(dbgenerated("gen_random_uuid()")) @map("assignment_id") @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid
  codigo String @db.VarChar(40)
  previousTechnicianId String? @map("previous_technician_id") @db.Uuid
  newTechnicianId String @map("new_technician_id") @db.Uuid
  assignmentMode String @map("assignment_mode") @db.VarChar(10)
  motivo String @db.VarChar(500)
  changedBy String @map("changed_by") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  changedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("changed_at") @db.Timestamptz(6)
  @@id([redAsistencialId,assignmentId])
  @@index([redAsistencialId,ticketId,changedAt,assignmentId],map:"ticket_assignment_history_ticket_idx")
  @@map("ticket_assignment_history")
  @@schema("app")
}

model TicketStateTransition {
  redAsistencialId String @map("red_asistencial_id") @db.Uuid
  transitionId String @default(dbgenerated("gen_random_uuid()")) @map("transition_id") @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid
  codigo String @db.VarChar(40)
  estadoAnterior String? @map("estado_anterior") @db.VarChar(20)
  estadoNuevo String @map("estado_nuevo") @db.VarChar(20)
  motivo String @db.VarChar(500)
  changedBy String @map("changed_by") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  changedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("changed_at") @db.Timestamptz(6)
  @@id([redAsistencialId,transitionId])
  @@index([redAsistencialId,ticketId,changedAt,transitionId],map:"ticket_state_history_ticket_idx")
  @@map("ticket_state_history")
  @@schema("app")
}
